<Window x:Class="Petek.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Petek.Desktop.Views"
        mc:Ignorable="d"
        Title="Petek Messenger"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.Resources>
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- User Profile (Top-Left) -->
                <Border Grid.Row="0" Padding="6,12,6,2">
                    <Button Style="{StaticResource IconButton}"
                            ToolTip="Profil"
                            Width="40" Height="40"
                            Click="ProfileButton_Click">
                        <Grid>
                            <Ellipse Width="34" Height="34"
                                     Fill="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="ProfileInitial"
                                       Text="?"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Ellipse x:Name="StatusIndicatorDot"
                                     Style="{StaticResource StatusIndicator}"
                                     Fill="{DynamicResource StatusAvailableBrush}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,-1,-1"/>
                        </Grid>
                    </Button>
                </Border>

                <!-- Status Change Button (Top-Left, under profile) -->
                <Border Grid.Row="1" Padding="4,0,4,6">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="🟢  Uygun" Click="StatusAvailable_Click"/>
                            <MenuItem Header="🔴  Meşgul" Click="StatusBusy_Click"/>
                            <MenuItem Header="🟡  Dışarıda" Click="StatusAway_Click"/>
                            <MenuItem Header="⚪  Görünmez" Click="StatusInvisible_Click"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Button x:Name="StatusButton"
                            ToolTip="Durumu Değiştir"
                            Click="StatusButton_Click"
                            Cursor="Hand"
                            HorizontalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock x:Name="StatusLabel" Text="▼" FontSize="8"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </Border>

                <!-- Navigation Items -->
                <StackPanel Grid.Row="2" Margin="0,4">
                    <RadioButton x:Name="NavChat"
                                 Style="{StaticResource SidebarNavItem}"
                                 IsChecked="True"
                                 ToolTip="Sohbetler"
                                 Checked="NavItem_Checked">
                        <TextBlock Text="&#xE8BD;" Style="{StaticResource NavIcon}"/>
                    </RadioButton>

                    <RadioButton x:Name="NavContacts"
                                 Style="{StaticResource SidebarNavItem}"
                                 ToolTip="Kişiler"
                                 Checked="NavItem_Checked">
                        <TextBlock Text="&#xE77B;" Style="{StaticResource NavIcon}"/>
                    </RadioButton>

                    <RadioButton x:Name="NavFiles"
                                 Style="{StaticResource SidebarNavItem}"
                                 ToolTip="Dosyalar"
                                 Checked="NavItem_Checked">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource NavIcon}"/>
                    </RadioButton>
                </StackPanel>

                <!-- Bottom - Settings + Logo -->
                <StackPanel Grid.Row="3" Margin="0,4,0,12">
                    <RadioButton x:Name="NavSettings"
                                 Style="{StaticResource SidebarNavItem}"
                                 ToolTip="Ayarlar"
                                 Checked="NavItem_Checked">
                        <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/>
                    </RadioButton>

                    <Border Padding="8,8,8,0">
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               Width="24" Height="24"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center"
                               Opacity="0.4"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240" MaxWidth="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- Conversation/Contact List Panel -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <Border Grid.Row="0" Padding="12">
                        <TextBox Style="{StaticResource FluentTextBox}"
                                 x:Name="SearchBox"
                                 Tag="Ara..."
                                 TextChanged="SearchBox_TextChanged"/>
                    </Border>

                    <Frame x:Name="ListFrame"
                           Grid.Row="1"
                           NavigationUIVisibility="Hidden"/>
                </Grid>
            </Border>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="1"
                          Background="{DynamicResource DividerBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"/>

            <!-- Chat/Detail View -->
            <Frame x:Name="ContentFrame"
                   Grid.Column="2"
                   NavigationUIVisibility="Hidden"/>
        </Grid>

        <!-- Toast Notification Container (bottom-right overlay) -->
        <StackPanel x:Name="ToastContainer"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Margin="0,0,20,20"
                    Width="360"/>
    </Grid>
</Window>
