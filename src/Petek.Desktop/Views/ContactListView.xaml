<Page x:Class="Petek.Desktop.Views.ContactListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="12,8">
            <Grid>
                <TextBlock Text="Kişiler"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Style="{StaticResource IconButton}"
                        HorizontalAlignment="Right"
                        ToolTip="Yeni Kategori Ekle"
                        Click="AddCategory_Click">
                    <TextBlock Text="&#xE710;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"/>
                </Button>
            </Grid>
        </Border>

        <!-- Contact categories TreeView -->
        <TreeView x:Name="ContactTree"
                  Grid.Row="1"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="4">

            <!-- Favorites -->
            <TreeViewItem x:Name="FavoritesNode" Header="Favoriler" IsExpanded="True">
                <TreeViewItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE734;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </TreeViewItem.HeaderTemplate>
            </TreeViewItem>

            <!-- All Contacts -->
            <TreeViewItem x:Name="AllContactsNode" Header="Tüm Kişiler" IsExpanded="True">
                <TreeViewItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </TreeViewItem.HeaderTemplate>
            </TreeViewItem>
        </TreeView>

        <!-- Search Results Panel -->
        <Border x:Name="SearchResultsPanel"
                Grid.Row="1"
                Visibility="Collapsed"
                Padding="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="SearchResultsTitle" Grid.Row="0" Text="Arama Sonuçları"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="12,8,12,4"/>
                <TreeView x:Name="SearchResultsList"
                          Grid.Row="1"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="4"/>
            </Grid>
        </Border>

        <!-- Empty search result -->
        <StackPanel x:Name="EmptySearchResult"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock Text="&#xE721;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="36"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Kişi bulunamadı"
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</Page>
