<Page x:Class="Petek.Desktop.Views.ChatView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Chat Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Contact Avatar -->
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Ellipse Width="40" Height="40"
                             Fill="{DynamicResource AccentBrushLight2}"/>
                    <TextBlock Text="{Binding CurrentConversation.Name, Converter={StaticResource InitialsConverter}, FallbackValue='?'}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrushDark1}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Ellipse Style="{StaticResource StatusIndicator}"
                             Fill="{DynamicResource StatusAvailableBrush}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="0,0,-2,-2"/>
                </Grid>

                <!-- Contact Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ContactName"
                               Text="{Binding CurrentConversation.Name, FallbackValue='Petek Messenger'}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="ContactStatus"
                               Text="{Binding ConnectionStatus, FallbackValue='Görüşme başlatmak için bir kişi arayın'}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}"
                            ToolTip="Mesajlarda Ara">
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            ToolTip="Daha Fazla">
                        <TextBlock Text="&#xE712;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Messages Area - Drag-and-drop destegi -->
        <ScrollViewer x:Name="MessagesScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="16"
                      AllowDrop="True"
                      Drop="MessagesArea_Drop"
                      DragOver="MessagesArea_DragOver">
            <ItemsControl x:Name="MessagesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <!-- Incoming Message -->
                            <Border Style="{StaticResource ChatBubbleIncoming}"
                                    Visibility="{Binding IsIncomingVisibility}">
                                <StackPanel>
                                    <!-- Dosya eki gosterimi -->
                                    <Border Visibility="{Binding HasAttachment, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Background="{DynamicResource SurfaceBrush}"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,0,0,6"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="Attachment_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A5;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="20"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding AttachmentName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding AttachmentSize}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding Content}"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasTextContent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Time}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Right"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Outgoing Message -->
                            <Border Style="{StaticResource ChatBubbleOutgoing}"
                                    Visibility="{Binding IsOutgoingVisibility}">
                                <StackPanel>
                                    <!-- Dosya eki gosterimi -->
                                    <Border Visibility="{Binding HasAttachment, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Background="#1AFFFFFF"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,0,0,6"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="Attachment_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A5;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="20"
                                                       Foreground="#E0FFFFFF"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding AttachmentName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"/>
                                                <TextBlock Text="{Binding AttachmentSize}"
                                                           FontSize="11"
                                                           Foreground="#B3FFFFFF"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding Content}"
                                               FontSize="14"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasTextContent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Time}"
                                                   FontSize="10"
                                                   Foreground="#B3FFFFFF"/>
                                        <TextBlock Text="{Binding StatusIcon}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Foreground="#B3FFFFFF"
                                                   Margin="4,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Drag-and-drop overlay -->
        <Border x:Name="DragDropOverlay"
                Grid.Row="1"
                Background="#CC000000"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="&#xE8A5;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="48"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Dosyayi buraya birakin"
                           FontSize="18"
                           Foreground="White"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Typing Indicator -->
        <Border x:Name="TypingIndicator"
                Grid.Row="1"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                Margin="16,0,0,8"
                Visibility="{Binding IsTyping, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding TypingUserName, StringFormat='{}{0} yazıyor...'}"
                       FontSize="12"
                       FontStyle="Italic"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
        </Border>

        <!-- Message Input Area -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Attachment Buttons -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="0,0,8,0">
                    <Button Style="{StaticResource IconButton}"
                            ToolTip="Dosya Ekle"
                            Click="AttachFile_Click">
                        <TextBlock Text="&#xE723;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            ToolTip="Ekran Görüntüsü"
                            Click="Screenshot_Click">
                        <TextBlock Text="&#xE722;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"/>
                    </Button>
                </StackPanel>

                <!-- Message Input -->
                <TextBox x:Name="MessageInput"
                         Grid.Column="1"
                         Style="{StaticResource FluentTextBox}"
                         Text=""
                         AcceptsReturn="True"
                         MaxHeight="120"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         KeyDown="MessageInput_KeyDown"
                         TextChanged="MessageInput_TextChanged"/>

                <!-- Send Button -->
                <Button Grid.Column="2"
                        Style="{StaticResource AccentButton}"
                        Margin="8,0,0,0"
                        Padding="12,8"
                        ToolTip="Gönder (Enter)"
                        Click="SendMessage_Click">
                    <TextBlock Text="&#xE724;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
