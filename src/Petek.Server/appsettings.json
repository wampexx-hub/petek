{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Type": "SQLite"
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=petek;Username=postgres;Password=",
    "SQLite": "Data Source=petek_v2.db",
    "Redis": "localhost:6379"
  },
  "Redundancy": {
    "Enabled": false,
    "NodeId": "node-1",
    "Nodes": [],
    "DatabaseReplicas": []
  },
  "SSO": {
    "Enabled": true,
    "WindowsAuth": true,
    "LDAP": {
      "Enabled": false,
      "Server": "",
      "Port": 389,
      "BaseDN": "",
      "BindDN": "",
      "BindPassword": "",
      "UserFilter": "(sAMAccountName={0})",
      "UseSsl": false
    },
    "SAML": {
      "Enabled": false,
      "EntityId": "",
      "MetadataUrl": "",
      "CertificatePath": "",
      "AssertionConsumerServiceUrl": ""
    }
  },
  "DLP": {
    "Enabled": false,
    "Rules": [],
    "ExternalTool": {
      "Enabled": false,
      "Type": "",
      "ApiUrl": "",
      "ApiKey": "",
      "ScanMessages": false,
      "ScanFiles": true,
      "BlockOnViolation": false
    }
  },
  "Cors": {
    "Origins": [
      "http://localhost:5000",
      "https://localhost:5001"
    ]
  },
  "FileStorage": {
    "Path": "./uploads",
    "MaxFileSizeBytes": 104857600
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "PetekMessenger",
    "Audience": "PetekDesktop",
    "ExpirationHours": 24
  }
